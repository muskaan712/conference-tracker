# Base URL of the deployed site, used for canonical URLs, the sitemap,
# robots.txt, and Open Graph metadata.
#
# Optional on Vercel: if unset, the app automatically falls back to Vercel's
# own VERCEL_PROJECT_PRODUCTION_URL / VERCEL_URL env vars (set for you on
# every deployment), and to http://localhost:3000 for local dev. Only set
# this explicitly once you've pinned a custom production domain.
NEXT_PUBLIC_SITE_URL=https://your-project.vercel.app

# --- Optional: GitHub API token for the "Last successful scan" tile ---
#
# The homepage reads the last successful run of weekly-conference-update.yml
# from the public GitHub Actions API. That works with no token at all; this
# only raises the unauthenticated rate limit (60 req/h per IP) for busy build
# environments. A read-only, public-repo-scoped token is enough.
#
# Server-only on purpose: it is NOT a NEXT_PUBLIC_* variable, is read only in
# src/lib/automation-status.ts during server rendering, and must never be
# exposed to the browser. If it is missing, rate-limited, or wrong, the tile
# falls back to the newest edition scan timestamp and the site still renders.
# GITHUB_TOKEN=

# --- Optional: Firebase Authentication + Firestore (cross-device accounts) ---
#
# Entirely optional. The public tracker, guest My Papers, and the planner
# all work with none of these set. Firebase only turns on when
# NEXT_PUBLIC_FIREBASE_ENABLED="true" AND every value below is present —
# see docs/FIREBASE_SETUP.md for how to create a Firebase project and fill
# these in. Never put a service-account key or any secret here; these are
# all public client-side config values (safe to expose, same as any other
# NEXT_PUBLIC_* variable), protected by firestore.rules rather than secrecy.
NEXT_PUBLIC_FIREBASE_ENABLED=false
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
