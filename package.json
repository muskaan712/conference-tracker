{
  "name": "conference-tracker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:emulator": "firebase emulators:exec --only firestore,auth --project demo-conference-tracker \"playwright test --config=playwright.emulator.config.ts\"",
    "test:rules": "firebase emulators:exec --only firestore --project demo-conference-tracker \"vitest run tests/firestore/rules.test.ts\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate-data": "tsx scripts/validate-conference-data.ts",
    "discover": "tsx scripts/discover-conferences.ts",
    "update-conferences": "tsx scripts/update-conferences.ts",
    "discover-events": "tsx scripts/discover-events.ts",
    "update-events": "tsx scripts/update-events.ts",
    "check-sources": "tsx scripts/check-source-health.ts"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "firebase": "^12.16.0",
    "lucide-react": "^1.27.0",
    "next": "16.2.12",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "@playwright/test": "^1.62.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20.19.43",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.4",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "firebase-tools": "^15.24.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "vitest": "^4.1.10",
    "yaml": "^2.9.0"
  }
}
